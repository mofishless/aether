{
  "protocol": "claude-stream-json",
  "description": "权限往返旅程：init → control_request(can_use_tool)（阻塞等 SDK canUseTool 桥应答）→ assistant 文本回填决策（$MOCK_LAST_PERM）→ result success。",
  "exitCode": 0,
  "events": [
    {
      "emit": {
        "type": "system",
        "subtype": "init",
        "session_id": "ext-mock-perm",
        "claude_code_version": "9.9.9-mock",
        "model": "mock-model",
        "cwd": "/wt/mock",
        "tools": ["Bash"],
        "permissionMode": "plan",
        "slash_commands": [],
        "mcp_servers": [],
        "output_style": "default",
        "skills": [],
        "plugins": [],
        "apiKeySource": "none"
      }
    },
    {
      "emit": {
        "type": "control_request",
        "request_id": "req-mock-perm",
        "request": {
          "subtype": "can_use_tool",
          "tool_name": "Bash",
          "input": { "command": "rm -rf /", "description": "mock 危险命令样例" },
          "tool_use_id": "toolu_mock_perm",
          "title": "mock CLI 想删除文件"
        }
      }
    },
    {
      "emit": {
        "type": "assistant",
        "message": {
          "id": "msg_mock_perm",
          "role": "assistant",
          "content": [{ "type": "text", "text": "决策:$MOCK_LAST_PERM" }]
        },
        "parent_tool_use_id": null,
        "uuid": "uuid_mock_perm",
        "session_id": "ext-mock-perm"
      }
    },
    {
      "emit": {
        "type": "result",
        "subtype": "success",
        "result": "mock 权限旅程完成",
        "is_error": false,
        "duration_ms": 4,
        "duration_api_ms": 4,
        "num_turns": 1,
        "session_id": "ext-mock-perm",
        "usage": {},
        "total_cost_usd": 0
      }
    }
  ]
}
